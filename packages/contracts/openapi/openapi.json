{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "HealthResponse",
        "type": "object"
      },
      "ImageSource": {
        "additionalProperties": false,
        "properties": {
          "client_image_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Client Image Id",
            "type": "string"
          },
          "rendered_height": {
            "exclusiveMinimum": 0.0,
            "title": "Rendered Height",
            "type": "integer"
          },
          "rendered_width": {
            "exclusiveMinimum": 0.0,
            "title": "Rendered Width",
            "type": "integer"
          },
          "source": {
            "format": "uri",
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "source_kind": {
            "const": "url",
            "title": "Source Kind",
            "type": "string"
          }
        },
        "required": [
          "client_image_id",
          "source_kind",
          "source",
          "rendered_width",
          "rendered_height"
        ],
        "title": "ImageSource",
        "type": "object"
      },
      "ShortcutTranslationResponse": {
        "additionalProperties": false,
        "properties": {
          "payload_version": {
            "minLength": 1,
            "title": "Payload Version",
            "type": "string"
          },
          "renderer_payload": {
            "minLength": 1,
            "title": "Renderer Payload",
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/ShortcutTranslationSummary"
          }
        },
        "required": ["renderer_payload", "payload_version", "summary"],
        "title": "ShortcutTranslationResponse",
        "type": "object"
      },
      "ShortcutTranslationSummary": {
        "additionalProperties": false,
        "properties": {
          "failed": {
            "minimum": 0.0,
            "title": "Failed",
            "type": "integer"
          },
          "successful": {
            "minimum": 0.0,
            "title": "Successful",
            "type": "integer"
          },
          "total": {
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": ["total", "successful", "failed"],
        "title": "ShortcutTranslationSummary",
        "type": "object"
      },
      "TranslationImageRequest": {
        "additionalProperties": false,
        "properties": {
          "image": {
            "$ref": "#/components/schemas/ImageSource"
          },
          "page_url": {
            "format": "uri",
            "minLength": 1,
            "title": "Page Url",
            "type": "string"
          },
          "reading_order": {
            "enum": ["auto", "ltr", "rtl"],
            "title": "Reading Order",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "source_language": {
            "enum": ["auto", "ja", "ko", "en"],
            "title": "Source Language",
            "type": "string"
          },
          "target_language": {
            "const": "zh-Hant",
            "title": "Target Language",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "page_url",
          "image",
          "source_language",
          "target_language",
          "reading_order"
        ],
        "title": "TranslationImageRequest",
        "type": "object"
      },
      "TranslationImageResponse": {
        "additionalProperties": false,
        "properties": {
          "client_image_id": {
            "title": "Client Image Id",
            "type": "string"
          },
          "image_height": {
            "exclusiveMinimum": 0.0,
            "title": "Image Height",
            "type": "integer"
          },
          "image_id": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Image Id",
            "type": "string"
          },
          "image_width": {
            "exclusiveMinimum": 0.0,
            "title": "Image Width",
            "type": "integer"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/TranslationRegion"
            },
            "title": "Regions",
            "type": "array"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "timing": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TranslationImageTiming"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "client_image_id",
          "image_id",
          "image_width",
          "image_height",
          "regions",
          "warnings"
        ],
        "title": "TranslationImageResponse",
        "type": "object"
      },
      "TranslationImageTiming": {
        "additionalProperties": false,
        "properties": {
          "fetch_ms": {
            "minimum": 0.0,
            "title": "Fetch Ms",
            "type": "number"
          },
          "gemini_calls": {
            "minimum": 0.0,
            "title": "Gemini Calls",
            "type": "integer"
          },
          "gemini_ms": {
            "minimum": 0.0,
            "title": "Gemini Ms",
            "type": "number"
          },
          "ocr_cache_hit": {
            "title": "Ocr Cache Hit",
            "type": "boolean"
          },
          "ocr_ms": {
            "minimum": 0.0,
            "title": "Ocr Ms",
            "type": "number"
          },
          "output_region_count": {
            "minimum": 0.0,
            "title": "Output Region Count",
            "type": "integer"
          },
          "queue_wait_ms": {
            "minimum": 0.0,
            "title": "Queue Wait Ms",
            "type": "number"
          },
          "source_region_count": {
            "minimum": 0.0,
            "title": "Source Region Count",
            "type": "integer"
          },
          "total_ms": {
            "minimum": 0.0,
            "title": "Total Ms",
            "type": "number"
          }
        },
        "required": [
          "fetch_ms",
          "ocr_ms",
          "gemini_ms",
          "total_ms",
          "queue_wait_ms",
          "ocr_cache_hit",
          "source_region_count",
          "output_region_count",
          "gemini_calls"
        ],
        "title": "TranslationImageTiming",
        "type": "object"
      },
      "TranslationPageFailure": {
        "additionalProperties": false,
        "properties": {
          "client_image_id": {
            "minLength": 1,
            "title": "Client Image Id",
            "type": "string"
          },
          "code": {
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": ["client_image_id", "code"],
        "title": "TranslationPageFailure",
        "type": "object"
      },
      "TranslationPageProgress": {
        "additionalProperties": false,
        "properties": {
          "completed": {
            "minimum": 0.0,
            "title": "Completed",
            "type": "integer"
          },
          "failed": {
            "minimum": 0.0,
            "title": "Failed",
            "type": "integer"
          },
          "successful": {
            "minimum": 0.0,
            "title": "Successful",
            "type": "integer"
          },
          "total": {
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": ["total", "completed", "successful", "failed"],
        "title": "TranslationPageProgress",
        "type": "object"
      },
      "TranslationPageRequest": {
        "additionalProperties": false,
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageSource"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Images",
            "type": "array"
          },
          "page_url": {
            "format": "uri",
            "minLength": 1,
            "title": "Page Url",
            "type": "string"
          },
          "reading_order": {
            "enum": ["auto", "ltr", "rtl"],
            "title": "Reading Order",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "source_language": {
            "enum": ["auto", "ja", "ko", "en"],
            "title": "Source Language",
            "type": "string"
          },
          "target_language": {
            "const": "zh-Hant",
            "title": "Target Language",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "page_url",
          "images",
          "source_language",
          "target_language",
          "reading_order"
        ],
        "title": "TranslationPageRequest",
        "type": "object"
      },
      "TranslationPageResponse": {
        "additionalProperties": false,
        "properties": {
          "failures": {
            "items": {
              "$ref": "#/components/schemas/TranslationPageFailure"
            },
            "title": "Failures",
            "type": "array"
          },
          "progress": {
            "$ref": "#/components/schemas/TranslationPageProgress"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/TranslationImageResponse"
            },
            "title": "Results",
            "type": "array"
          },
          "timing": {
            "$ref": "#/components/schemas/TranslationPageTiming"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": ["request_id", "results", "failures", "progress", "warnings", "timing"],
        "title": "TranslationPageResponse",
        "type": "object"
      },
      "TranslationPageTiming": {
        "additionalProperties": false,
        "properties": {
          "cold_start_ms": {
            "minimum": 0.0,
            "title": "Cold Start Ms",
            "type": "number"
          },
          "fetch_ms": {
            "minimum": 0.0,
            "title": "Fetch Ms",
            "type": "number"
          },
          "gemini_calls": {
            "minimum": 0.0,
            "title": "Gemini Calls",
            "type": "integer"
          },
          "gemini_ms": {
            "minimum": 0.0,
            "title": "Gemini Ms",
            "type": "number"
          },
          "ocr_cache_hits": {
            "minimum": 0.0,
            "title": "Ocr Cache Hits",
            "type": "integer"
          },
          "ocr_ms": {
            "minimum": 0.0,
            "title": "Ocr Ms",
            "type": "number"
          },
          "queue_wait_ms": {
            "minimum": 0.0,
            "title": "Queue Wait Ms",
            "type": "number"
          },
          "total_ms": {
            "minimum": 0.0,
            "title": "Total Ms",
            "type": "number"
          },
          "warm_execution": {
            "title": "Warm Execution",
            "type": "boolean"
          }
        },
        "required": [
          "total_ms",
          "fetch_ms",
          "ocr_ms",
          "gemini_ms",
          "queue_wait_ms",
          "cold_start_ms",
          "gemini_calls",
          "ocr_cache_hits",
          "warm_execution"
        ],
        "title": "TranslationPageTiming",
        "type": "object"
      },
      "TranslationRegion": {
        "additionalProperties": false,
        "properties": {
          "background_style": {
            "default": "translucent",
            "enum": ["opaque", "translucent"],
            "title": "Background Style",
            "type": "string"
          },
          "detection_confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Detection Confidence",
            "type": "number"
          },
          "orientation": {
            "enum": ["vertical", "horizontal"],
            "title": "Orientation",
            "type": "string"
          },
          "polygon": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "minimum": 0.0,
                  "type": "integer"
                },
                {
                  "minimum": 0.0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "maxItems": 4,
            "minItems": 4,
            "title": "Polygon",
            "type": "array"
          },
          "recognition_confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Recognition Confidence",
            "type": "number"
          },
          "region_id": {
            "minLength": 1,
            "title": "Region Id",
            "type": "string"
          },
          "source_text": {
            "title": "Source Text",
            "type": "string"
          },
          "translated_text": {
            "title": "Translated Text",
            "type": "string"
          }
        },
        "required": [
          "region_id",
          "polygon",
          "source_text",
          "translated_text",
          "orientation",
          "detection_confidence",
          "recognition_confidence"
        ],
        "title": "TranslationRegion",
        "type": "object"
      },
      "TranslationWarmupResponse": {
        "additionalProperties": false,
        "properties": {
          "diagnostic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diagnostic"
          },
          "initialization_ms": {
            "minimum": 0.0,
            "title": "Initialization Ms",
            "type": "number"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": ["ready", "initialization_ms"],
        "title": "TranslationWarmupResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "bearerFormat": "opaque",
        "description": "All translation requests require the configured private-LAN local token.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "summary": "Private-LAN manga translation with M0 compatibility and M2.2 thin transports",
    "title": "Penguin Translator API",
    "version": "0.3.0-m2.2"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": ["health"]
      }
    },
    "/v1/shortcut/translate-page": {
      "post": {
        "description": "Decode a thin-Shortcut form request and reuse the page translation pipeline.",
        "operationId": "translate_page_for_shortcut_v1_shortcut_translate_page_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortcutTranslationResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Translate Page For Shortcut",
        "tags": ["translation"]
      }
    },
    "/v1/translate-image": {
      "post": {
        "description": "Preserve M0 mock requests and execute the M1 real pipeline for auto-language requests.",
        "operationId": "translate_image_v1_translate_image_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslationImageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationImageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Translate Image",
        "tags": ["translation"]
      }
    },
    "/v1/translate-page": {
      "post": {
        "description": "Translate a page with bounded image preparation and cross-image Gemini batches.",
        "operationId": "translate_page_v1_translate_page_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslationPageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationPageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Translate Page",
        "tags": ["translation"]
      }
    },
    "/v1/warmup": {
      "post": {
        "description": "Initialize the local OCR pipeline without sending content to Gemini.",
        "operationId": "warmup_translation_v1_warmup_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationWarmupResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Warmup Translation",
        "tags": ["translation"]
      }
    }
  }
}
