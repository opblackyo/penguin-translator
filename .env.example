PENGUIN_TRANSLATOR_TRANSLATION_PROVIDER=gemini
PENGUIN_TRANSLATOR_GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
PENGUIN_TRANSLATOR_LOCAL_API_TOKEN=

PENGUIN_TRANSLATOR_OCR_PROVIDER=paddleocr
PENGUIN_TRANSLATOR_PADDLEOCR_LANGUAGE=korean
PENGUIN_TRANSLATOR_PADDLEOCR_DETECTION_MODEL=PP-OCRv5_mobile_det
PENGUIN_TRANSLATOR_PADDLEOCR_RECOGNITION_MODEL=korean_PP-OCRv5_mobile_rec
PADDLE_PDX_CACHE_HOME=services/api/.cache/paddlex
PENGUIN_TRANSLATOR_OCR_MIN_CONFIDENCE=0.5
PENGUIN_TRANSLATOR_OCR_CACHE_TTL_SECONDS=300
PENGUIN_TRANSLATOR_OCR_CACHE_MAX_ENTRIES=64
PENGUIN_TRANSLATOR_MAX_CONCURRENT_TRANSLATIONS=2
PENGUIN_TRANSLATOR_PAGE_BATCH_MAX_IMAGES=30
PENGUIN_TRANSLATOR_GEMINI_BATCH_MAX_REGIONS=80
PENGUIN_TRANSLATOR_GEMINI_BATCH_MAX_CHARACTERS=12000
PENGUIN_TRANSLATOR_SHORTCUT_FORM_MAX_BYTES=350000
PENGUIN_TRANSLATOR_SHORTCUT_PAYLOAD_MAX_DECODED_BYTES=262144
PENGUIN_TRANSLATOR_DEV_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

PENGUIN_TRANSLATOR_IMAGE_FETCH_TIMEOUT_SECONDS=10
PENGUIN_TRANSLATOR_IMAGE_FETCH_MAX_BYTES=10485760
PENGUIN_TRANSLATOR_IMAGE_FETCH_MAX_REDIRECTS=3
PENGUIN_TRANSLATOR_IMAGE_MAX_PIXELS=40000000

# Development only. Set exact host:port targets, for example <WINDOWS_LAN_IPV4>:4173.
# Never enable private-address fetching by default or commit an actual LAN address.
PENGUIN_TRANSLATOR_DEV_ALLOWED_IMAGE_TARGETS=
