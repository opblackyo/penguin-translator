{
  "manifest_version": 3,
  "name": "Penguin Translator Private Dev",
  "version": "0.1.0",
  "description": "Private-development-only Edge shell for the local Penguin Translator API.",
  "action": {
    "default_title": "Translate current page"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
